{
  "case_name": "case1_power6_multi",
  "power_map": "power6",
  "geometry": {
    "x_size": 0.02,
    "y_size": 0.02,
    "top_thickness": 0.0005,
    "middle_thickness": 0.0001,
    "bottom_thickness": 0.0005,
    "xy_resolution": 0.0002,
    "z_resolution": 0.00002,
    "ambient_temperature": 293.15,
    "source_conductivity": 125.0,
    "medium_conductivity": 395.0
  },
  "boundary": {
    "top": {
      "type": "Robin",
      "param": 8700.0
    },
    "bottom": {
      "type": "Robin",
      "param": 8700.0
    },
    "lateral": {
      "type": "Neumann",
      "param": 0.0
    },
    "epsilon": {
      "dirichlet": 1e-8,
      "neumann": 7.5e-7,
      "robin": 7.5e-7
    }
  },
  "data": {
    "power_density_path": "../data/date_2026_comsol_data/power 6/fine mesh temp/testcase1_power.bin",
    "ground_truth_path": "../data/date_2026_comsol_data/power 6/fine mesh temp/testcase1_temp.bin"
  },
  "walker": {
    "max_steps": 5e7,
    "cutoff_weight": 0.03,
    "delta_x": 5e-7,
    "use_tail_correction": true
  },
  "query_grid": {
    "x_indices": [10, 20, 30, 40],
    "y_indices": [10, 20, 30, 40]
  },
  "run": {
    "num_samples": 400,
    "num_workers": -1
  },
  "output": {
    "directory": "../outputs/reproduce/case1_power6_multi",
    "csv": "FastRw.csv",
    "constraints": "data.json"
  }
}
